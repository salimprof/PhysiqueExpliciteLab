<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Theme of the Physique Explicite Lab screens (follows the day/night mode chosen by the user). -->
    <style name="Theme.PELab" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pe_primary</item>
        <item name="colorOnPrimary">@color/pe_on_primary</item>
        <item name="colorSecondary">@color/pe_accent</item>
        <item name="colorTertiary">@color/pe_orange</item>
        <item name="android:colorBackground">@color/pe_bg</item>
        <item name="colorSurface">@color/pe_bg</item>
        <item name="colorSurfaceContainer">@color/pe_card</item>
        <item name="colorOnSurface">@color/pe_on_bg</item>
        <item name="colorOnSurfaceVariant">@color/pe_on_bg_variant</item>
        <item name="colorOutline">@color/pe_card_stroke</item>
        <item name="colorSecondaryContainer">@color/pe_nav_indicator</item>
        <item name="colorOnSecondaryContainer">@color/pe_on_bg</item>
        <item name="android:windowBackground">@color/pe_bg</item>
        <item name="android:textColorPrimary">@color/pe_on_bg</item>
        <item name="android:textColorSecondary">@color/pe_on_bg_variant</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.PELab.Card</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.PELab.Dialog</item>
    </style>

    <style name="ShapeAppearance.PELab.Card" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ThemeOverlay.PELab.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurfaceContainerHigh">@color/pe_card</item>
    </style>

    <style name="PELab.Text.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/pe_on_bg</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PELab.Text.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/pe_on_bg</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="PELab.Text.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/pe_on_bg_variant</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="PELab.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/pe_card</item>
        <item name="strokeColor">@color/pe_card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="PELab.SectionHeader" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/pe_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
</resources>
