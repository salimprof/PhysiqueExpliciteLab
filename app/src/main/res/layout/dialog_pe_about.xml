<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pe_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/pe_circle_badge"
                android:contentDescription="@string/pe_logo_description"
                android:padding="6dp"
                app:srcCompat="@drawable/ic_pe_atom" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/pe_on_bg"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pe_about_version_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pe_accent"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pe_signature"
                    android:textColor="@color/pe_orange"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/PELab.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/pe_about_description" />

        <!-- Modification Notice & Non-affiliation (GPL v3 Section 5a + Point 5 & 7) -->
        <TextView
            style="@style/PELab.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pe_about_customization_title" />

        <TextView
            android:id="@+id/pe_about_mod_notice_tv"
            style="@style/PELab.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pe_about_customization" />

        <!-- Original Authors & Copyrights (Point 1 & 2) -->
        <TextView
            style="@style/PELab.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pe_about_original_title" />

        <TextView
            style="@style/PELab.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pe_about_original" />

        <TextView
            style="@style/PELab.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/pe_about_source_original" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pe_about_repo_btn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/pe_about_open_repo" />

        <!-- Separate Section: Source code of this modified version (Point 3 & 4) -->
        <TextView
            style="@style/PELab.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pe_about_modified_source_title" />

        <TextView
            android:id="@+id/pe_about_modified_source_tv"
            style="@style/PELab.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pe_about_modified_repo_btn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/pe_about_open_modified_repo"
            android:visibility="gone" />

        <!-- License & Full GPL v3 Text (Point 1 & 6) -->
        <TextView
            style="@style/PELab.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pe_about_license_title" />

        <TextView
            style="@style/PELab.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pe_about_license" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pe_about_full_gpl_btn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/pe_about_full_license" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pe_about_engine_credits_btn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/pe_about_engine_credits" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pe_about_close_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="14dp"
            android:text="@string/pe_close" />
    </LinearLayout>
</ScrollView>
